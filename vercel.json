{
  "version": 2,
  "builds": [
    { "src": "api/portfolio.py",        "use": "@vercel/python" },
    { "src": "api/chat.py",             "use": "@vercel/python" },
    { "src": "api/contact.py",          "use": "@vercel/python" },
    { "src": "api/admin.py",            "use": "@vercel/python" },
    { "src": "api/telegram_webhook.py", "use": "@vercel/python" },
    { "src": "public/**",               "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/portfolio",          "dest": "/api/portfolio.py"        },
    { "src": "/api/chat",               "dest": "/api/chat.py"             },
    { "src": "/api/contact",            "dest": "/api/contact.py"          },
    { "src": "/api/admin/(.*)",         "dest": "/api/admin.py"            },
    { "src": "/api/admin",              "dest": "/api/admin.py"            },
    { "src": "/api/telegram-webhook",   "dest": "/api/telegram_webhook.py" },
    { "src": "/sitemap.xml",            "dest": "/public/sitemap.xml"      },
    { "src": "/robots.txt",             "dest": "/public/robots.txt"       },
    { "src": "/assets/(.*)",            "dest": "/public/assets/$1"        },
    { "src": "/css/(.*)",               "dest": "/public/css/$1"           },
    { "src": "/js/(.*)",                "dest": "/public/js/$1"            },
    { "src": "/admin",                  "dest": "/public/admin.html"       },
    { "src": "/(.*)",                   "dest": "/public/index.html"       }
  ]
}
